generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Uygulama çalışma zamanı: Supabase'in pgbouncer bağlantı havuzu (port 6543).
  url       = env("DATABASE_URL")
  // Migration'lar (prisma migrate) pgbouncer'ın transaction modunda çalışmaz;
  // bu yüzden migration'lar için havuzsuz doğrudan bağlantı (port 5432) kullanılır.
  directUrl = env("DIRECT_URL")
}

model Product {
  id                String      @id @default(cuid())
  trendyolProductId String      @unique
  trendyolUrl       String
  name              String
  // Trendyol ürün sayfasından (og:image) çekilir; ilk taramaya kadar null kalır.
  imageUrl          String?
  isTracked         Boolean     @default(true)
  // Ayarlanırsa, scraper bu puanın altındaki yorumları hiç depolamaz (1-5).
  // null = filtresiz, tüm puanlar çekilir. Geriye dönük mevcut yorumları etkilemez,
  // yalnızca bundan sonraki taramalarda neyin depolanacağını belirler.
  minRating         Int?
  // Sitede aynı anda en fazla bu kadar yorum "vitrin"de tutulur (en yeni N).
  // Yeni uygun bir yorum eklendiğinde en eskisi vitrinden düşer.
  maxDisplayedReviews Int       @default(50)
  // Müşterinin kendi e-ticaret sitesindeki ürün kodu (örn. İdeaSoft stok kodu).
  // Widget bunu tek bir site-geneli script'ten {productStockcode} gibi bir
  // şablon değişkeniyle alıp /resolve endpoint'i üzerinden doğru ürünü bulur —
  // her ürün için ayrı script yazmaya gerek kalmaz.
  externalRef       String?     @unique
  // Hangi müşteri sitesine ait olduğunu belirten basit bir etiket (örn. "enwood").
  // /resolve, externalRef zaten benzersiz olsa da, script'in YANLIŞ siteye
  // yapıştırılması durumunda başka bir müşterinin yorumunun sızmasını engellemek
  // için storeId'nin de eşleşmesini zorunlu kılar.
  storeId           String?
  lastScrapedAt     DateTime?
  createdAt         DateTime    @default(now())
  reviews           Review[]
  scrapeLogs        ScrapeLog[]
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  trendyolReviewId String   @unique
  rating           Int
  comment          String
  authorName       String
  hasPhoto         Boolean  @default(false)
  photoUrls        String[] @default([])
  reviewDate       DateTime
  helpfulCount     Int      @default(0)
  commentLength    Int      @default(0)
  isApproved       Boolean  @default(true)
  isHidden         Boolean  @default(false)
  // syncDisplayedReviews tarafından hesaplanır: vitrindeki (en yeni N) yorumları işaretler.
  isDisplayed      Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([productId, rating])
  @@index([productId, reviewDate])
  @@index([productId, commentLength])
  @@index([productId, isDisplayed])
}

model ScrapeLog {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String
  newReviews   Int       @default(0)
  errorMessage String?
}
