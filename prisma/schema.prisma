generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Uygulama çalışma zamanı: Supabase'in pgbouncer bağlantı havuzu (port 6543).
  url       = env("DATABASE_URL")
  // Migration'lar (prisma migrate) pgbouncer'ın transaction modunda çalışmaz;
  // bu yüzden migration'lar için havuzsuz doğrudan bağlantı (port 5432) kullanılır.
  directUrl = env("DIRECT_URL")
}

// Bir müşteri hesabı (kiracı). enwood pilot müşteri olarak scripts/create-account.ts
// ile oluşturulur — kod içinde hiçbir yerde özel olarak referans verilmez, sadece
// çalışma zamanında var olan bir veri satırıdır. Sonraki her müşteri aynı script'le
// eklenir.
model Account {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  users     User[]
  products  Product[]
}

// Bir hesaba giriş yapabilen kişi. Faz 1'de hesap başına tek kullanıcı var,
// ama Account'tan ayrı tutuldu ki ileride (Faz 3) aynı hesaba ikinci bir
// kullanıcı davet etmek şema değişikliği gerektirmesin.
model User {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id                String      @id @default(cuid())
  // Nullable: mevcut production verisi scripts/create-account.ts ile geriye dönük
  // doldurulana kadar boş kalabilir. Faz 2'de tüm okuma/yazma yolları bunu zorunlu
  // kabul edecek; DB seviyesinde NOT NULL kısıtı, geri dönük doldurma doğrulandıktan
  // sonra ayrı bir migration'da eklenecek.
  accountId         String?
  account           Account?    @relation(fields: [accountId], references: [id])
  trendyolProductId String      @unique
  trendyolUrl       String
  name              String
  // Trendyol ürün sayfasından (og:image) çekilir; ilk taramaya kadar null kalır.
  imageUrl          String?
  isTracked         Boolean     @default(true)
  // Ayarlanırsa, scraper bu puanın altındaki yorumları hiç depolamaz (1-5).
  // null = filtresiz, tüm puanlar çekilir. Geriye dönük mevcut yorumları etkilemez,
  // yalnızca bundan sonraki taramalarda neyin depolanacağını belirler.
  minRating         Int?
  // Sitede aynı anda en fazla bu kadar yorum "vitrin"de tutulur (en yeni N).
  // Yeni uygun bir yorum eklendiğinde en eskisi vitrinden düşer.
  maxDisplayedReviews Int       @default(50)
  // Müşterinin kendi e-ticaret sitesindeki ürün kodu (örn. İdeaSoft stok kodu).
  // Widget bunu tek bir site-geneli script'ten {productStockcode} gibi bir
  // şablon değişkeniyle alıp /resolve endpoint'i üzerinden doğru ürünü bulur —
  // her ürün için ayrı script yazmaya gerek kalmaz.
  externalRef       String?     @unique
  // Hangi müşteri sitesine ait olduğunu belirten basit bir etiket (örn. "enwood").
  // /resolve, externalRef zaten benzersiz olsa da, script'in YANLIŞ siteye
  // yapıştırılması durumunda başka bir müşterinin yorumunun sızmasını engellemek
  // için storeId'nin de eşleşmesini zorunlu kılar.
  storeId           String?
  // Aynı fiziksel ürünün farklı boy/beden varyantlarını (örn. 120/140/160cm) birbirine
  // bağlar. Doldurulursa, bu değeri paylaşan ürünlerin yorumları widget'ta VE
  // özet puanında birlikte (havuzlanmış) gösterilir — sırf santim farklı diye bir
  // varyantın yorumsuz görünmesini önler. Boşsa ürün her zamanki gibi tek başına.
  reviewGroupId     String?
  lastScrapedAt     DateTime?
  createdAt         DateTime    @default(now())
  reviews           Review[]
  scrapeLogs        ScrapeLog[]

  @@index([reviewGroupId])
  @@index([accountId])
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  trendyolReviewId String   @unique
  rating           Int
  comment          String
  authorName       String
  hasPhoto         Boolean  @default(false)
  photoUrls        String[] @default([])
  reviewDate       DateTime
  helpfulCount     Int      @default(0)
  commentLength    Int      @default(0)
  isApproved       Boolean  @default(true)
  isHidden         Boolean  @default(false)
  // syncDisplayedReviews tarafından hesaplanır: vitrindeki (en yeni N) yorumları işaretler.
  isDisplayed      Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([productId, rating])
  @@index([productId, reviewDate])
  @@index([productId, commentLength])
  @@index([productId, isDisplayed])
}

model ScrapeLog {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String
  newReviews   Int       @default(0)
  errorMessage String?
}
