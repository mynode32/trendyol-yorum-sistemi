generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Uygulama çalışma zamanı: Supabase'in pgbouncer bağlantı havuzu (port 6543).
  url       = env("DATABASE_URL")
  // Migration'lar (prisma migrate) pgbouncer'ın transaction modunda çalışmaz;
  // bu yüzden migration'lar için havuzsuz doğrudan bağlantı (port 5432) kullanılır.
  directUrl = env("DIRECT_URL")
}

// Bir müşteri hesabı (kiracı). scripts/create-account.ts ile oluşturulur.
model Account {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  users     User[]
  products  Product[]
}

// Bir hesaba giriş yapabilen kişi. Account'tan ayrı tutulur ki ileride aynı
// hesaba ikinci bir kullanıcı eklemek şema değişikliği gerektirmesin.
model User {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  // Parola değiştiğinde artırılır; eski imzalı oturumları anında geçersiz kılar.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
}

enum UserRole {
  OWNER
  ADMIN
  VIEWER
}

// Hesap silinirse eski denetim izi korunabilsin diye Account/User'a foreign key
// bağlamıyoruz; accountId ve actorUserId salt referans olarak tutulur.
model AuditLog {
  id          String   @id @default(cuid())
  accountId   String
  actorUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([targetType, targetId])
}

model Product {
  id                String      @id @default(cuid())
  accountId         String
  account           Account     @relation(fields: [accountId], references: [id])
  trendyolProductId String      @unique
  trendyolUrl       String
  name              String
  // Trendyol ürün sayfasından (og:image) çekilir; ilk taramaya kadar null kalır.
  imageUrl          String?
  isTracked         Boolean     @default(true)
  // Ayarlanırsa, scraper bu puanın altındaki yorumları hiç depolamaz (1-5). null = filtresiz.
  minRating         Int?
  // Sitede aynı anda en fazla bu kadar yorum "vitrin"de tutulur (en yeni N).
  maxDisplayedReviews Int       @default(50)
  // Müşterinin kendi sitesindeki ürün kodu; widget /resolve üzerinden bununla eşleştirir.
  externalRef       String?     @unique
  // Hangi müşteri sitesine ait olduğunu belirten etiket; script yanlış siteye
  // yapıştırılırsa başka bir müşterinin yorumunun sızmasını engeller.
  storeId           String?
  // Aynı ürünün farklı boy/beden varyantlarını birbirine bağlar; doldurulursa bu
  // değeri paylaşan ürünlerin yorumları birlikte (havuzlanmış) gösterilir.
  reviewGroupId     String?
  // Atomik updateMany koşuluyla kullanılan dağıtık tarama kilidi.
  scrapeLockedAt    DateTime?
  lastScrapedAt     DateTime?
  createdAt         DateTime    @default(now())
  reviews           Review[]
  scrapeLogs        ScrapeLog[]

  @@index([reviewGroupId])
  @@index([accountId])
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  trendyolReviewId String   @unique
  rating           Int
  comment          String
  authorName       String
  hasPhoto         Boolean  @default(false)
  photoUrls        String[] @default([])
  reviewDate       DateTime
  helpfulCount     Int      @default(0)
  commentLength    Int      @default(0)
  isApproved       Boolean  @default(true)
  isHidden         Boolean  @default(false)
  // syncDisplayedReviews tarafından hesaplanır: vitrindeki (en yeni N) yorumları işaretler.
  isDisplayed      Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([productId, rating])
  @@index([productId, reviewDate])
  @@index([productId, commentLength])
  @@index([productId, isDisplayed])
}

model ScrapeLog {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String
  newReviews   Int       @default(0)
  errorMessage String?
}
