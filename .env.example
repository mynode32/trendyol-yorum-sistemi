DATABASE_URL="postgresql://trendyol:trendyol@localhost:5432/trendyol_reviews"
# Supabase kullanılıyorsa: DATABASE_URL = pooled bağlantı (port 6543, ?pgbouncer=true),
# DIRECT_URL = doğrudan bağlantı (port 5432). Yerelde ikisi de aynı adres olabilir.
DIRECT_URL="postgresql://trendyol:trendyol@localhost:5432/trendyol_reviews"
# En az 32 karakterlik kriptografik rastgele bir değer üretin:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-cryptographically-random-secret"
# Opsiyonel: başarısız worker koşularında JSON POST alan alarm webhook'u.
SCRAPE_ALERT_WEBHOOK_URL=""
# Opsiyonel: login rate limit'i tek instance bellek yerine merkezi Upstash Redis'te
# tutmak için. Vercel + Upstash entegrasyonu bu iki değeri otomatik ayarlar.
# Boş bırakılırsa (yerel geliştirme/testler) bellek içi limite düşülür.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
