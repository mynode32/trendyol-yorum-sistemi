DATABASE_URL="postgresql://trendyol:trendyol@localhost:5432/trendyol_reviews"
# Supabase kullanılıyorsa: DATABASE_URL = pooled bağlantı (port 6543, ?pgbouncer=true),
# DIRECT_URL = doğrudan bağlantı (port 5432). Yerelde ikisi de aynı adres olabilir.
DIRECT_URL="postgresql://trendyol:trendyol@localhost:5432/trendyol_reviews"
ADMIN_PASSWORD="changeme"
SESSION_SECRET="changeme-32-char-random-string"
# Opsiyonel: başarısız worker koşularında JSON POST alan alarm webhook'u.
SCRAPE_ALERT_WEBHOOK_URL=""
# Opsiyonel: admin panelinde sidebar ve ürünler sayfasında gösterilecek mağaza adı
# (örn. "enwood"). NEXT_PUBLIC_ ön eki ile tarayıcıya gömülür, gizli bir değer değildir.
NEXT_PUBLIC_STORE_NAME=""
